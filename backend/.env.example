APP_ENV=development
DATABASE_URL=sqlite:///./village-v2.db
APP_SECRET=local-development-only-change-before-production
WEB_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,capacitor://localhost,https://localhost,http://localhost
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
VERIFY_EMAIL=false
SUPPORT_EMAIL=support@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Village <hello@example.com>
SMTP_TLS=true
FIREBASE_CREDENTIALS_JSON=

# Optional HTTPS email provider; avoids SMTP egress restrictions.
RESEND_API_KEY=
