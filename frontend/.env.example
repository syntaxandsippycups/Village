# Development: API is on port 8000, Next development server is on port 3000.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Production same-origin web build: NEXT_PUBLIC_API_URL=/api
# Native app build: NEXT_PUBLIC_API_URL=https://YOUR-DOMAIN/api
# Native share links: NEXT_PUBLIC_WEB_URL=https://YOUR-DOMAIN
NEXT_TELEMETRY_DISABLED=1
